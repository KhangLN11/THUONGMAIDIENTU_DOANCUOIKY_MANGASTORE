# Copy to .env.local; restart Vite after changes.
VITE_USE_PRODUCTS_API=false
VITE_PRODUCTS_API_BASE_URL=/api
# Server-side Vite config only (not included in browser bundle):
PRODUCTS_API_PROXY_TARGET=http://localhost
# Production without a reverse proxy: VITE_PRODUCTS_API_BASE_URL=/manga-store/backend/public/api
